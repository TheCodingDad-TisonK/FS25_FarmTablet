    </title>
    <description>
        <en>Farm Tablet v2 - Complete overhaul. Central tablet interface for farm management with sidebar navigation, rich data visualisation and modular app system.</en>
        <de>Farm Tablet v2 – Komplette Überarbeitung. Zentrale Tablet-Oberfläche mit Sidebar-Navigation, reichhaltiger Datenvisualisierung und modularem App-System.</de>
        <fr>Farm Tablet v2 - Refonte complète. Interface tablette centrale avec navigation latérale, visualisation de données avancée et système d'applications modulaire.</fr>
        <da>Farm Tablet v2 - Komplet redesign. Central tabletgrænseflade til styring af gården med navigation i sidebjælken, detaljeret datavisualisering og et modulært app-system.</da>
    </description>
    <iconFilename>icon.dds</iconFilename>

    <multiplayer supported="true"/>

    <extraSourceFiles>
        <sourceFile filename="src/main.lua" />
    </extraSourceFiles>

    <!-- Tablet Charging Station: a physical placeable that recharges the tablet
         battery when the player stands on its pad. The spec talks to the existing
         battery system via g_currentMission.farmTablet:setAtCharger(). -->
    <placeableSpecializations>
        <specialization name="tabletCharger" className="PlaceableTabletCharger" filename="src/placeables/PlaceableTabletCharger.lua" />
    </placeableSpecializations>

    <placeableTypes>
        <type name="tabletCharger" parent="simplePlaceable" filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="tabletCharger" />
        </type>
    </placeableTypes>

    <storeItems>
        <storeItem xmlFilename="placeables/tabletCharger/tabletChargingStation.xml" />
    </storeItems>

    <actions>
        <!-- ONFOOT only: Wizard locked player context for this pass, no vehicle
             binding. The tablet is a full screen, not a driving control. -->
        <action name="FT_TOGGLE_TABLET" category="ONFOOT" />
    </actions>

